{
  "name": "@allocyn/sdk",
  "version": "0.1.0",
  "description": "Typed client for the Allocyn contract on GenLayer: read jobs and receipts, and send writes signed by the caller's own wallet.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "test": "node --test test/*.test.ts src/core/contract/*.test.ts src/core/domain/*.test.ts",
    "sync": "node ../../scripts/sync-core.mjs",
    "sync:check": "node ../../scripts/sync-core.mjs --check",
    "build": "node scripts/build.mjs"
  },
  "peerDependencies": {
    "genlayer-js": "^1.1.8"
  },
  "peerDependenciesMeta": {
    "genlayer-js": {
      "optional": true
    }
  },
  "license": "UNLICENSED",
  "private": true
}
