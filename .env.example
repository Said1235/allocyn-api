# Allocyn API configuration. None of these is a secret; NEVER put a private key or seed phrase here
# (the API refuses to start if it finds PRIVATE_KEY / SEED / MNEMONIC variables).

NODE_ENV=development                 # development | test | production
PORT=8787
HOST=0.0.0.0

# Network. Only "studionet" is supported today.
GENLAYER_NETWORK=studionet
# Optional. genlayer-js 1.1.8 uses its own network preset, so this must be empty or equal to the preset's RPC.
GENLAYER_RPC_URL=
# Optional. Empty = the contract address bundled with the SDK for the network.
# Pointing this at a contract with a different interface or limits needs a new SDK release (see docs, "Updating the contract").
ALLOCYN_CONTRACT_ADDRESS=

# Public URL of this API (used in /openapi.json and the docs).
API_BASE_URL=http://localhost:8787

# Browser origins allowed to call the API, comma separated. Empty = "*" in development, none in production.
# "*" is refused in production.
CORS_ORIGINS=

# "latest" includes non-final state; "final" reads finalized state only. Per request: ?consistency=final
READ_CONSISTENCY=latest

RATE_LIMIT_MAX=60                    # requests per window per client
RATE_LIMIT_WINDOW_MS=60000
TRUST_PROXY=false                    # true only behind a proxy you control (uses X-Forwarded-For)
REQUEST_TIMEOUT_MS=25000
